# Copy to deploy/chiltepin/.env and fill in. That file is git-ignored; keep the
# password out of the repository.
#
# The API's read-only database user, addressed by the compose service name "db".
DATABASE_URL=postgresql://drs_readonly:PASSWORD@db:5432/drugcentral
# Superuser password for the database container. Only used if the data volume is
# ever created from scratch; the existing volume is already restored.
POSTGRES_PASSWORD=CHANGE_ME
